---
import WorkLayout from '../../layouts/WorkLayout.astro';
import { getDepartmentStaticPaths, getEntryDetail } from '../../lib/content';

export const getStaticPaths = () => getDepartmentStaticPaths('art');

const { entry } = Astro.props;
const { Content } = await getEntryDetail(entry);

const data = entry.rawEntry.data;
---

<WorkLayout
  entry={entry}
  department="art"
  metaItems={[data.medium, data.dimensions, data.materials.join(' · '), data.exhibition]}
  links={data.links}
>
  <Content />
</WorkLayout>
