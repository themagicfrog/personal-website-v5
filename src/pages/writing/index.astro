---
import Layout from '../../layouts/Layout.astro';
import SectionHero from '../../components/SectionHero.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { getPublishedCollection, sortByDate } from '../../lib/content';
import { accentForDepartment, descriptionForDepartment } from '../../data/site';

const entries = sortByDate(await getPublishedCollection('writing'));
const accent = accentForDepartment('writing');
---

<Layout
  title="Writing"
  description="Fiction, journalism, essays, and stories."
  section="/writing"
  hideHeader
  miniNav
>
  <SectionHero
    title="Writing"
    description={descriptionForDepartment('writing')}
    accent={accent}
  />

  <WorkGrid entries={entries} emptyMessage="New writing will be filed here soon." accent={accent} />
</Layout>
