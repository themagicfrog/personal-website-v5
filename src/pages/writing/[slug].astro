---
import WorkLayout from '../../layouts/WorkLayout.astro';
import { getDepartmentStaticPaths, getEntryDetail } from '../../lib/content';
import { formatWordCount, formatReadingTime } from '../../lib/format';

export const getStaticPaths = () => getDepartmentStaticPaths('writing');

const { entry } = Astro.props;
const { Content } = await getEntryDetail(entry);

const data = entry.rawEntry.data;
---

<WorkLayout
  entry={entry}
  department="writing"
  metaItems={[data.genre, data.wordCount ? formatWordCount(data.wordCount) : undefined, data.readingTime ? formatReadingTime(data.readingTime) : undefined]}
  links={data.links}
>
  <Content />
</WorkLayout>
