---
import WorkLayout from '../../layouts/WorkLayout.astro';
import { getDepartmentStaticPaths, getEntryDetail } from '../../lib/content';

export const getStaticPaths = () => getDepartmentStaticPaths('photography');

const { entry } = Astro.props;
const { Content } = await getEntryDetail(entry);

const data = entry.rawEntry.data;
const links = [data.link ? { label: 'See More', href: data.link } : null].filter(
  (link): link is { label: string; href: string } => link !== null
);
---

<WorkLayout
  entry={entry}
  department="photography"
  metaItems={[data.location, data.camera, data.photoCount ? `${data.photoCount} photographs` : undefined, data.themes.join(' / ')]}
  links={links}
  galleryLayout="contact-sheet"
>
  <Content />
</WorkLayout>
