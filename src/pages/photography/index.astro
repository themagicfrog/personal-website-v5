---
import Layout from '../../layouts/Layout.astro';
import SectionHero from '../../components/SectionHero.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import SocialCallout from '../../components/SocialCallout.astro';
import { getPhotographyEntries } from '../../lib/photography';
import { site, accentForDepartment, descriptionForDepartment } from '../../data/site';

const entries = getPhotographyEntries();
const accent = accentForDepartment('photography');
const instagram = site.contact.find((link) => link.label === 'Instagram');
---

<Layout
  title="Photography"
  description="Street scenes, journeys, people, details, and visual collections."
  section="/photography"
  miniNav
>
  <SectionHero
    title="Photography"
    description={descriptionForDepartment('photography')}
    accent={accent}
  >
    {instagram && (
      <SocialCallout
        slot="aside"
        href={instagram.href}
        icon="/images/instagram.svg"
        lead="i share my photography on Instagram"
        cta="follow along!"
        accent={accent}
      />
    )}
  </SectionHero>

  <PhotoGallery entries={entries} emptyMessage="New photographic collections will be filed here soon." accent={accent} />
</Layout>
