---
import Layout from '../../layouts/Layout.astro';
import SectionHero from '../../components/SectionHero.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { getPublishedCollection, sortByDate } from '../../lib/content';
import { accentForDepartment, descriptionForDepartment } from '../../data/site';

const entries = sortByDate(await getPublishedCollection('photography'));
const accent = accentForDepartment('photography');
---

<Layout
  title="Photography"
  description="Street scenes, journeys, people, details, and visual collections."
  section="/photography"
  hideHeader
  miniNav
>
  <SectionHero
    title="Photography"
    description={descriptionForDepartment('photography')}
    accent={accent}
  />

  <PhotoGallery entries={entries} emptyMessage="New photographic collections will be filed here soon." accent={accent} />
</Layout>
