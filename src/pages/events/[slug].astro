---
import WorkLayout from '../../layouts/WorkLayout.astro';
import { getDepartmentStaticPaths, getEntryDetail } from '../../lib/content';

export const getStaticPaths = () => getDepartmentStaticPaths('events');

const { entry } = Astro.props;
const { Content } = await getEntryDetail(entry);

const data = entry.rawEntry.data;
---

<WorkLayout
  entry={entry}
  department="events"
  metaItems={[data.location, data.eventType, data.attendance ? `${data.attendance} attendees` : undefined]}
  links={data.links}
>
  <Content />
</WorkLayout>
