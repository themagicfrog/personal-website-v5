---
import WorkLayout from '../../layouts/WorkLayout.astro';
import { getDepartmentStaticPaths, getEntryDetail } from '../../lib/content';

export const getStaticPaths = () => getDepartmentStaticPaths('builds');

const { entry } = Astro.props;
const { Content } = await getEntryDetail(entry);

const data = entry.rawEntry.data;
---

<WorkLayout
  entry={entry}
  department="builds"
  metaItems={[data.projectType, data.tools.join(' · '), data.status]}
  links={data.links}
>
  <Content />
</WorkLayout>
