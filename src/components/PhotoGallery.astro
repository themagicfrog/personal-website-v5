---
import type { NormalizedEntry } from '../lib/content';
import { getImageAspectRatio } from '../lib/image';
import { formatDateShort } from '../lib/format';
import EmptyState from './EmptyState.astro';

interface Props {
  entries: NormalizedEntry[];
  emptyMessage: string;
  accent: string;
}

const { entries, emptyMessage, accent } = Astro.props;

const photos = entries.map((entry) => ({
  slug: entry.slug,
  src: entry.coverImage,
  alt: entry.title,
  title: entry.title,
  meta: [formatDateShort(entry.date), entry.rawEntry.data.location].filter(Boolean).join(' · '),
  recognition: entry.recognition,
  aspectRatio: getImageAspectRatio(entry.coverImage),
}));
---

{
  photos.length === 0 ? (
    <div class="wrap">
      <EmptyState message={emptyMessage} accent={accent} />
    </div>
  ) : (
    <>
      <div class="photo-gallery wrap" style={`--accent: ${accent}`}>
        {photos.map((photo, i) => (
          <button
            type="button"
            class="photo-item"
            style={`--aspect: ${photo.aspectRatio}`}
            data-photo
            data-slug={photo.slug}
            data-src={photo.src}
            data-alt={photo.alt}
            data-title={photo.title}
            data-meta={photo.meta}
            data-recognition={photo.recognition ?? ''}
            aria-label={`View ${photo.title}`}
          >
            <img src={photo.src} alt={photo.alt} loading={i < 8 ? 'eager' : 'lazy'} />
            <span class="photo-caption">
              <span class="photo-title">{photo.title}</span>
              {(photo.meta || photo.recognition) && (
                <span class="photo-sub">
                  {photo.meta && <span class="photo-meta">{photo.meta}</span>}
                  {photo.recognition && <span class="photo-recognition">{photo.recognition}</span>}
                </span>
              )}
            </span>
          </button>
        ))}
      </div>

      <div class="lightbox" data-lightbox hidden style={`--accent: ${accent}`}>
        <div class="lightbox-backdrop" data-lightbox-close></div>
        <button type="button" class="lightbox-control lightbox-close" data-lightbox-close aria-label="Close">
          ✕
        </button>
        <button type="button" class="lightbox-control lightbox-prev" data-lightbox-prev aria-label="Previous photo">
          ‹
        </button>
        <button type="button" class="lightbox-control lightbox-next" data-lightbox-next aria-label="Next photo">
          ›
        </button>
        <figure class="lightbox-figure">
          <img data-lightbox-img src="" alt="" />
          <figcaption>
            <span class="lightbox-title" data-lightbox-title />
            <span class="lightbox-sub">
              <span class="lightbox-meta" data-lightbox-meta />
              <span class="lightbox-recognition" data-lightbox-recognition />
            </span>
          </figcaption>
        </figure>
      </div>
    </>
  )
}

<style>
  .photo-gallery {
    column-count: 1;
    column-gap: var(--space-5);
    padding-bottom: var(--space-9);
  }

  @media (min-width: 640px) {
    .photo-gallery {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .photo-gallery {
      column-count: 3;
    }
  }

  @media (min-width: 1440px) {
    .photo-gallery {
      column-count: 4;
    }
  }

  .photo-item {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    break-inside: avoid;
    margin-bottom: var(--space-5);
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
  }

  .photo-item img {
    display: block;
    width: 100%;
    aspect-ratio: var(--aspect);
    object-fit: cover;
    border-radius: var(--radius-small);
    transition: transform 0.3s var(--ease-standard);
  }

  .photo-item:hover img,
  .photo-item:focus-visible img {
    transform: scale(1.015);
  }

  .photo-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-4) var(--space-3);
    border-radius: 0 0 var(--radius-small) var(--radius-small);
    background: linear-gradient(to top, rgba(16, 12, 8, 0.72), rgba(16, 12, 8, 0));
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s var(--ease-standard), transform 0.2s var(--ease-standard);
    pointer-events: none;
  }

  .photo-item:hover .photo-caption,
  .photo-item:focus-visible .photo-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .photo-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.15rem;
    color: #fff;
  }

  .photo-sub {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-family: var(--font-label);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .photo-recognition {
    color: var(--accent);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink-dark) 45%, transparent);
    backdrop-filter: blur(3px);
  }

  .lightbox-figure {
    position: relative;
    z-index: 1;
    max-width: min(90vw, 1200px);
    max-height: 88vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .lightbox-figure img {
    display: block;
    max-width: 100%;
    max-height: 76vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-small);
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.6);
  }

  .lightbox-figure figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
  }

  .lightbox-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    color: #fff;
  }

  .lightbox-title:empty {
    display: none;
  }

  .lightbox-sub {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1) var(--space-3);
    font-family: var(--font-label);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  .lightbox-meta:empty,
  .lightbox-recognition:empty {
    display: none;
  }

  .lightbox-recognition {
    color: var(--accent);
  }

  .lightbox-control {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s var(--ease-standard), transform 0.2s var(--ease-standard);
  }

  .lightbox-control:hover,
  .lightbox-control:focus-visible {
    background: rgba(255, 255, 255, 0.22);
  }

  .lightbox-close {
    top: var(--space-5);
    right: var(--space-5);
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    font-size: 1.1rem;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    font-size: 1.75rem;
    transform: translateY(-50%);
  }

  .lightbox-prev:hover,
  .lightbox-prev:focus-visible {
    transform: translateY(-50%) translateX(-2px);
  }

  .lightbox-next:hover,
  .lightbox-next:focus-visible {
    transform: translateY(-50%) translateX(2px);
  }

  .lightbox-prev {
    left: var(--space-5);
  }

  .lightbox-next {
    right: var(--space-5);
  }

  @media (max-width: 640px) {
    .lightbox-prev,
    .lightbox-next {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.4rem;
    }

    .lightbox-prev {
      left: var(--space-2);
    }

    .lightbox-next {
      right: var(--space-2);
    }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo]'));
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');

  if (lightbox && items.length > 0) {
    const backdrop = lightbox.querySelectorAll<HTMLElement>('[data-lightbox-close]');
    const prevBtn = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const nextBtn = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const img = lightbox.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const titleEl = lightbox.querySelector<HTMLElement>('[data-lightbox-title]');
    const metaEl = lightbox.querySelector<HTMLElement>('[data-lightbox-meta]');
    const recognitionEl = lightbox.querySelector<HTMLElement>('[data-lightbox-recognition]');

    let activeIndex = -1;
    let lastFocused: HTMLElement | null = null;

    function show(index: number) {
      const item = items[index];
      if (!item || !img || !titleEl || !metaEl || !recognitionEl) return;

      activeIndex = index;
      img.src = item.dataset.src ?? '';
      img.alt = item.dataset.alt ?? '';
      titleEl.textContent = item.dataset.title ?? '';
      metaEl.textContent = item.dataset.meta ?? '';
      recognitionEl.textContent = item.dataset.recognition ?? '';
    }

    function open(index: number) {
      lastFocused = document.activeElement as HTMLElement | null;
      show(index);
      lightbox!.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox!.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    function step(delta: number) {
      const next = (activeIndex + delta + items.length) % items.length;
      show(next);
    }

    items.forEach((item, index) => {
      item.addEventListener('click', () => open(index));
    });

    backdrop.forEach((el) => el.addEventListener('click', close));
    prevBtn?.addEventListener('click', () => step(-1));
    nextBtn?.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (event) => {
      if (lightbox!.hidden) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });

    function openBySlug(slug: string) {
      const index = items.findIndex((item) => item.dataset.slug === slug);
      if (index === -1) return;
      items[index].scrollIntoView({ block: 'center' });
      open(index);
    }

    const initialSlug = window.location.hash.slice(1);
    if (initialSlug) openBySlug(initialSlug);
  }
</script>
