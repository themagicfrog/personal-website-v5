---
import { entryData, type NormalizedEntry } from '../lib/content';
import { getImageAspectRatio } from '../lib/image';
import { formatDateShort } from '../lib/format';
import EmptyState from './EmptyState.astro';

interface Props {
  entries: NormalizedEntry[];
  emptyMessage: string;
  accent: string;
  itemNoun?: string;
}

const { entries, emptyMessage, accent, itemNoun = 'Photograph' } = Astro.props;

const photos = entries.flatMap((entry) => {
  const meta = [formatDateShort(entry.date), entry.rawEntry.data.location].filter(Boolean).join(' · ');
  const images = entry.images.length > 0 ? entry.images : entry.coverImage ? [entry.coverImage] : [];
  const featured = new Set((entryData(entry).featuredImages as string[] | undefined) ?? []);

  return images.map((src, imageIndex) => ({
    entrySlug: entry.slug,
    src,
    imageIndex,
    count: images.length,
    alt: entry.title || (meta ? `${itemNoun}, ${meta}` : itemNoun),
    title: entry.title,
    meta,
    recognition: entry.recognition,
    aspectRatio: getImageAspectRatio(src),
    featured: featured.has(src),
  }));
});

const featuredPhotos = photos.filter((photo) => photo.featured);
---

{
  photos.length === 0 ? (
    <div class="wrap">
      <EmptyState message={emptyMessage} accent={accent} />
    </div>
  ) : (
    <>
      {featuredPhotos.length > 0 && (
        <section class="featured wrap" style={`--accent: ${accent}`}>
          <div class="featured-head">
            <h2 class="featured-heading">featured</h2>
            <p class="featured-tagline">a few of my favorites</p>
          </div>
          <div class="featured-row">
            <div class="featured-track">
              {[...featuredPhotos, ...featuredPhotos].map((photo, i) => {
                const isClone = i >= featuredPhotos.length;
                return (
                  <button
                    type="button"
                    class="photo-item featured-item"
                    style={`--aspect: ${photo.aspectRatio}`}
                    data-featured-photo
                    data-src={photo.src}
                    aria-label={`View ${photo.alt}`}
                    aria-hidden={isClone ? 'true' : undefined}
                    tabindex={isClone ? -1 : undefined}
                  >
                    <span class="photo-frame">
                      <img class="photo-cover" src={photo.src} alt={isClone ? '' : photo.alt} loading="eager" />
                    </span>
                    <span class="photo-caption">
                      <span class="photo-title">{photo.title}</span>
                      {(photo.meta || photo.recognition) && (
                        <span class="photo-sub">
                          {photo.meta && <span class="photo-meta">{photo.meta}</span>}
                          {photo.recognition && <span class="photo-recognition">{photo.recognition}</span>}
                        </span>
                      )}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
          <div class="featured-rule" aria-hidden="true"></div>
        </section>
      )}

      <div class="photo-gallery wrap" style={`--accent: ${accent}`}>
        {photos.map((photo, i) => (
          <button
            type="button"
            class="photo-item"
            style={`--aspect: ${photo.aspectRatio}`}
            data-photo
            data-entry-slug={photo.entrySlug}
            data-src={photo.src}
            data-image-index={photo.imageIndex}
            data-count={photo.count}
            data-alt={photo.alt}
            data-title={photo.title}
            data-meta={photo.meta}
            data-recognition={photo.recognition ?? ''}
            aria-label={`View ${photo.alt}`}
          >
            <span class="photo-frame">
              <img class="photo-cover" src={photo.src} alt={photo.alt} loading={i < 8 ? 'eager' : 'lazy'} />
            </span>
            <span class="photo-caption">
              <span class="photo-title">{photo.title}</span>
              {(photo.meta || photo.recognition) && (
                <span class="photo-sub">
                  {photo.meta && <span class="photo-meta">{photo.meta}</span>}
                  {photo.recognition && <span class="photo-recognition">{photo.recognition}</span>}
                </span>
              )}
            </span>
          </button>
        ))}
      </div>

      <div class="lightbox" data-lightbox hidden style={`--accent: ${accent}`}>
        <div class="lightbox-backdrop" data-lightbox-close></div>
        <button type="button" class="lightbox-control lightbox-close" data-lightbox-close aria-label="Close">
          ✕
        </button>
        <button type="button" class="lightbox-control lightbox-prev" data-lightbox-prev aria-label="Previous photo">
          ‹
        </button>
        <button type="button" class="lightbox-control lightbox-next" data-lightbox-next aria-label="Next photo">
          ›
        </button>
        <figure class="lightbox-figure">
          <div class="lightbox-image-wrap">
            <img data-lightbox-img src="" alt="" />
            <div class="lightbox-dots" data-lightbox-dots hidden></div>
          </div>
          <figcaption>
            <span class="lightbox-title" data-lightbox-title />
            <span class="lightbox-sub">
              <span class="lightbox-meta" data-lightbox-meta />
              <span class="lightbox-count" data-lightbox-count />
              <span class="lightbox-recognition" data-lightbox-recognition />
            </span>
          </figcaption>
        </figure>
      </div>
    </>
  )
}

<style>
  .featured {
    padding-bottom: var(--space-7);
  }

  .featured-head {
    margin-bottom: var(--space-5);
  }

  .featured-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.2;
    color: var(--accent);
  }

  .featured-tagline {
    margin-top: var(--space-1);
    font-family: var(--font-label);
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .featured-row {
    --featured-height: 13rem;
    --featured-gap: var(--space-4);
    position: relative;
    z-index: 2;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
    mask-image: linear-gradient(to right, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
  }

  .featured-track {
    display: flex;
    width: max-content;
    gap: var(--featured-gap);
    animation: featured-drift 60s linear infinite;
  }

  @keyframes featured-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - var(--featured-gap) / 2));
    }
  }

  .featured-row:hover .featured-track,
  .featured-row:focus-within .featured-track {
    animation-play-state: paused;
  }

  .featured-row .featured-item {
    flex: 0 0 calc(var(--aspect) * var(--featured-height));
    width: calc(var(--aspect) * var(--featured-height));
    height: var(--featured-height);
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .featured-row {
      --featured-height: 10rem;
    }
  }

  @media (max-width: 640px) {
    .featured-row {
      --featured-height: 8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-row {
      overflow-x: auto;
    }

    .featured-track {
      animation: none;
    }
  }

  .featured-rule {
    margin-top: var(--space-7);
    height: 1px;
    background-color: color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .photo-gallery {
    column-count: 1;
    column-gap: var(--space-5);
    padding-bottom: var(--space-9);
  }

  @media (min-width: 640px) {
    .photo-gallery {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .photo-gallery {
      column-count: 3;
    }
  }

  @media (min-width: 1440px) {
    .photo-gallery {
      column-count: 4;
    }
  }

  .photo-item {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    break-inside: avoid;
    margin-bottom: var(--space-5);
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
  }

  .photo-frame {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    aspect-ratio: var(--aspect);
    overflow: hidden;
    border-radius: var(--radius-small);
  }

  .photo-cover {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--ease-standard);
  }

  .photo-item:hover .photo-cover,
  .photo-item:focus-visible .photo-cover {
    transform: scale(1.015);
  }

  .photo-caption {
    position: absolute;
    z-index: 2;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-4) var(--space-3);
    border-radius: 0 0 var(--radius-small) var(--radius-small);
    background: linear-gradient(to top, rgba(16, 12, 8, 0.72), rgba(16, 12, 8, 0));
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s var(--ease-standard), transform 0.2s var(--ease-standard);
    pointer-events: none;
  }

  .photo-item:hover .photo-caption,
  .photo-item:focus-visible .photo-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .photo-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.15rem;
    color: #fff;
  }

  .photo-title:empty {
    display: none;
  }

  .photo-sub {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-family: var(--font-label);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.85);
  }

  .photo-recognition {
    color: color-mix(in srgb, var(--recognition) 80%, white 20%);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink-dark) 45%, transparent);
    backdrop-filter: blur(3px);
  }

  .lightbox-figure {
    position: relative;
    z-index: 1;
    max-width: min(90vw, 1200px);
    max-height: 88vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .lightbox-image-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-figure img {
    display: block;
    max-width: 100%;
    max-height: 76vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-small);
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.6);
  }

  .lightbox-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .lightbox-dots[hidden] {
    display: none;
  }

  .lightbox-dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s var(--ease-standard), transform 0.2s var(--ease-standard);
  }

  .lightbox-dot:hover,
  .lightbox-dot:focus-visible {
    transform: scale(1.2);
  }

  .lightbox-dot[aria-current='true'] {
    background: var(--accent);
  }

  .lightbox-count:empty {
    display: none;
  }

  .lightbox-figure figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
  }

  .lightbox-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    color: #fff;
  }

  .lightbox-title:empty {
    display: none;
  }

  .lightbox-sub {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1) var(--space-3);
    font-family: var(--font-label);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.8);
  }

  .lightbox-meta:empty,
  .lightbox-recognition:empty {
    display: none;
  }

  .lightbox-recognition {
    color: color-mix(in srgb, var(--recognition) 80%, white 20%);
  }

  .lightbox-control {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    border: 2px solid var(--accent);
    background-color: color-mix(in srgb, var(--accent) 14%, var(--paper-light));
    box-shadow: 2px 2px 0 -1px var(--paper), 3px 3px 0 -1px var(--accent);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s var(--ease-standard), color 0.2s var(--ease-standard),
      transform 0.2s var(--ease-standard);
  }

  .lightbox-control:hover,
  .lightbox-control:focus-visible {
    background-color: var(--accent);
    color: var(--paper-light);
  }

  .lightbox-close {
    top: var(--space-5);
    right: var(--space-5);
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.1rem;
    transform: rotate(-4deg);
  }

  .lightbox-close:hover,
  .lightbox-close:focus-visible {
    transform: rotate(-4deg) scale(1.08);
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    width: 3.25rem;
    height: 3.25rem;
    font-size: 1.75rem;
  }

  .lightbox-prev {
    left: var(--space-5);
    transform: translateY(-50%) rotate(3deg);
  }

  .lightbox-next {
    right: var(--space-5);
    transform: translateY(-50%) rotate(-3deg);
  }

  .lightbox-prev:hover,
  .lightbox-prev:focus-visible {
    transform: translateY(-50%) rotate(3deg) translateX(-2px);
  }

  .lightbox-next:hover,
  .lightbox-next:focus-visible {
    transform: translateY(-50%) rotate(-3deg) translateX(2px);
  }

  @media (max-width: 640px) {
    .lightbox-prev,
    .lightbox-next {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.4rem;
    }

    .lightbox-prev {
      left: var(--space-2);
    }

    .lightbox-next {
      right: var(--space-2);
    }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo]'));
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');

  if (lightbox && items.length > 0) {
    const backdrop = lightbox.querySelectorAll<HTMLElement>('[data-lightbox-close]');
    const prevBtn = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const nextBtn = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const img = lightbox.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const titleEl = lightbox.querySelector<HTMLElement>('[data-lightbox-title]');
    const metaEl = lightbox.querySelector<HTMLElement>('[data-lightbox-meta]');
    const countEl = lightbox.querySelector<HTMLElement>('[data-lightbox-count]');
    const recognitionEl = lightbox.querySelector<HTMLElement>('[data-lightbox-recognition]');
    const dotsEl = lightbox.querySelector<HTMLElement>('[data-lightbox-dots]');

    let activeIndex = -1;
    let lastFocused: HTMLElement | null = null;

    function show(index: number) {
      const item = items[index];
      if (!item || !img || !titleEl || !metaEl || !countEl || !recognitionEl || !dotsEl) return;

      activeIndex = index;
      const count = Number(item.dataset.count ?? '1');
      const imageIndex = Number(item.dataset.imageIndex ?? '0');

      img.src = item.dataset.src ?? '';
      img.alt = item.dataset.alt ?? '';
      titleEl.textContent = item.dataset.title ?? '';
      metaEl.textContent = item.dataset.meta ?? '';
      countEl.textContent = count > 1 ? `${imageIndex + 1} / ${count}` : '';
      recognitionEl.textContent = item.dataset.recognition ?? '';

      const entrySlug = item.dataset.entrySlug;
      const siblingIndices = count > 1
        ? items.reduce<number[]>((acc, it, i) => {
            if (it.dataset.entrySlug === entrySlug) acc.push(i);
            return acc;
          }, [])
        : [];

      dotsEl.innerHTML = '';
      dotsEl.hidden = siblingIndices.length <= 1;
      siblingIndices.forEach((siblingIndex, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'lightbox-dot';
        dot.setAttribute('aria-label', `Go to image ${i + 1}`);
        dot.setAttribute('aria-current', String(siblingIndex === activeIndex));
        dot.addEventListener('click', () => show(siblingIndex));
        dotsEl.appendChild(dot);
      });
    }

    function open(index: number) {
      lastFocused = document.activeElement as HTMLElement | null;
      show(index);
      lightbox!.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox!.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    function step(delta: number) {
      show((activeIndex + delta + items.length) % items.length);
    }

    items.forEach((item, index) => {
      item.addEventListener('click', () => open(index));
    });

    document.querySelectorAll<HTMLButtonElement>('[data-featured-photo]').forEach((tile) => {
      tile.addEventListener('click', () => {
        const index = items.findIndex((item) => item.dataset.src === tile.dataset.src);
        if (index !== -1) open(index);
      });
    });

    backdrop.forEach((el) => el.addEventListener('click', close));
    prevBtn?.addEventListener('click', () => step(-1));
    nextBtn?.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (event) => {
      if (lightbox!.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      }
    });

    function openByEntrySlug(slug: string) {
      const index = items.findIndex((item) => item.dataset.entrySlug === slug);
      if (index === -1) return;
      items[index].scrollIntoView({ block: 'center' });
      open(index);
    }

    const initialSlug = window.location.hash.slice(1);
    if (initialSlug) openByEntrySlug(initialSlug);
  }
</script>
