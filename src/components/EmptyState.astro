---
interface Props {
  message: string;
  accent?: string;
}

const { message, accent = 'var(--ink-muted)' } = Astro.props;
---

<div class="empty-state wobbly-border tilt-c" style={`--accent: ${accent}`}>
  <p class="message">{message}</p>
</div>

<style>
  .empty-state {
    border: 1.5px dashed var(--accent);
    padding: var(--space-6) var(--space-5);
    background-color: var(--paper-light);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: 32rem;
  }

  .message {
    font-family: var(--font-note);
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--ink);
  }
</style>
