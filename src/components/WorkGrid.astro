---
import type { NormalizedEntry } from '../lib/content';
import WorkCard from './WorkCard.astro';
import EmptyState from './EmptyState.astro';

interface Props {
  entries: NormalizedEntry[];
  emptyMessage: string;
  accent: string;
  showCta?: boolean;
  layout?: 'grid' | 'row';
}

const { entries, emptyMessage, accent, showCta = true, layout = 'grid' } = Astro.props;
---

<div class="wrap">
  {entries.length === 0 ? (
    <EmptyState message={emptyMessage} accent={accent} />
  ) : (
    <div class:list={['grid', { row: layout === 'row' }]}>
      {entries.map((entry) => <WorkCard entry={entry} showCta={showCta} />)}
    </div>
  )}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1680px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .grid.row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .grid.row :global(.work-card) {
    width: auto;
    flex: 0 1 auto;
  }

  .grid.row :global(.image-frame) {
    width: auto;
    height: clamp(200px, 24vw, 340px);
  }

  .grid.row :global(.image-frame img) {
    width: auto;
    height: 100%;
  }
</style>
