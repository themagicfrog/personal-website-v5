---
import type { NormalizedEntry } from '../lib/content';
import WorkCard from './WorkCard.astro';
import EmptyState from './EmptyState.astro';

interface Props {
  entries: NormalizedEntry[];
  emptyMessage: string;
  accent: string;
  layout?: 'grid' | 'row';
}

const { entries, emptyMessage, accent, layout = 'grid' } = Astro.props;
---

<div class="wrap">
  {entries.length === 0 ? (
    <EmptyState message={emptyMessage} accent={accent} />
  ) : (
    <div class:list={['grid', { row: layout === 'row' }]}>
      {entries.map((entry) => <WorkCard entry={entry} />)}
    </div>
  )}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1680px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .grid.row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .grid.row {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .grid.row :global(.work-card) {
      flex: var(--aspect-scalar, 1.3333) 1 0;
      min-width: 0;
    }
  }
</style>
