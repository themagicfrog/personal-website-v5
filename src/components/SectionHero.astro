---
interface Props {
  title: string;
  description: string;
  accent: string;
}

const { title, description, accent } = Astro.props;
const hasAside = Astro.slots.has('aside');
const descriptionParagraphs = description.split('\n\n');
---

<header class="section-hero wrap" style={`--accent: ${accent}`}>
  <div class="section-hero-top">
    <h1 class="title-texture">{title}</h1>
    {hasAside && (
      <div class="section-hero-aside">
        <slot name="aside" />
      </div>
    )}
  </div>
  {descriptionParagraphs.map((paragraph) => (
    <p class="description" set:html={paragraph}></p>
  ))}
  <div class="rule" aria-hidden="true"></div>
</header>

<style>
  .section-hero {
    padding-block: var(--space-6) var(--space-6);
  }

  .section-hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-bottom: var(--space-5);
  }

  .section-hero-aside {
    flex: 0 0 auto;
    margin-inline-start: auto;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .description {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    line-height: 1.45;
    color: var(--ink);
  }

  .description + .description {
    margin-top: var(--space-4);
  }

  .description :global(a) {
    color: var(--accent);
    text-decoration: none;
  }

  .description :global(a:hover),
  .description :global(a:focus-visible) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 2px;
  }

  .rule {
    margin-top: var(--space-6);
    height: 3px;
    background-color: var(--accent);
    width: 4rem;
  }
</style>
