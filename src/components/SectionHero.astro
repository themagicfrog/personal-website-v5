---
interface Props {
  title: string;
  description: string;
  accent: string;
}

const { title, description, accent } = Astro.props;
const hasAside = Astro.slots.has('aside');
const descriptionParagraphs = description.split('\n\n');
---

<header class="section-hero wrap" style={`--accent: ${accent}`}>
  <div class="section-hero-top" class:list={{ 'has-aside': hasAside }}>
    <div class="section-hero-main">
      <h1 class="title-texture">{title}</h1>
      {descriptionParagraphs.map((paragraph) => (
        <p class="description">{paragraph}</p>
      ))}
    </div>
    {hasAside && (
      <div class="section-hero-aside">
        <slot name="aside" />
      </div>
    )}
  </div>
  <div class="rule" aria-hidden="true"></div>
</header>

<style>
  .section-hero {
    padding-block: var(--space-6) var(--space-6);
  }

  .section-hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .section-hero-main {
    flex: 1 1 320px;
    min-width: 0;
  }

  .section-hero-aside {
    flex: 0 1 340px;
    display: flex;
    justify-content: flex-end;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-5);
  }

  .description {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    line-height: 1.45;
    max-width: 62ch;
    color: var(--ink);
  }

  .description + .description {
    margin-top: var(--space-4);
  }

  .rule {
    margin-top: var(--space-6);
    height: 3px;
    background-color: var(--accent);
    width: 4rem;
  }
</style>
